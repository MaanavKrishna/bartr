# Copy to `.env.local` and fill in. The app builds and the pure logic tests
# without any of these; anything that actually queries the database will tell
# you clearly if DATABASE_URL is missing.

# ---------------------------------------------------------------- application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Bartr

# ------------------------------------------------------------------- database
# Supabase → Project Settings → Database → Connection string.
#   * Migrations (`npm run db:migrate`): use the SESSION pooler URL, port 5432.
#   * The app itself: use the TRANSACTION pooler URL, port 6543. The client
#     already sets `prepare: false`, which that pooler requires.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Running Postgres locally instead (needs the postgis and pg_trgm extensions):
# DATABASE_URL=postgres://postgres@localhost:5432/bartr

# ----------------------------------------------------------------------- auth
# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-side only — bypasses row level security. Never expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
